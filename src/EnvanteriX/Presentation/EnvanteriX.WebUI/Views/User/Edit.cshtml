@model UpdateUserViewModel
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">
            <div class="card-body">
                <h1 class="mb-4 card-title">Kullanıcı Bilgilerini Güncelleyebilirsiniz.</h1>
                @using (Html.BeginForm("Edit", "User", FormMethod.Post, new { @action = "/User/Edit" }))
                {
                    <div class="row mb-3">
                        <label for="Id" class="col-sm-2 col-form-label">Kullanıcı Id</label>
                        <div class="col-sm-10">
                            <input type="hidden" asp-for="Id" />
                            <label class="form-control" id="Id" asp-for="Id">@Model.Id </label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Adı ve Soyadı</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(Model => Model.FullName, new { @class = "form-control", type = "text", placeholder = "Ad ve Soyadı Girin" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Kullanıcı Adı</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(Model => Model.UserName, new { @class = "form-control", type = "text", placeholder = "Kullanıcı Adı Girin" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Email" class="col-sm-2 col-form-label">Mail</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.Email, new {
                            @class = "form-control",
                                                type = "email",
                                                placeholder = "Mail adresinizi girin"
                                                })
                    </div>
                </div>
                
                <div class="row mb-3">
                    <label for="UserName" class="col-sm-2 col-form-label">Rol Seçin</label>
                    <div class="col-sm-10">
                        @Html.DropDownList("RoleId", ViewBag.Roles as SelectList, new { @class = " select2 form-control", id = "roleSelect" })
                    </div>
                </div>

                    <div class="row mb-3 mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-lg btn-primary me-2">Kaydet</button>
                            <button type="button" class="btn btn-lg btn-secondary" onclick="history.back();">Geri Dön</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function() {
        $('#roleSelect').select2({
             theme: 'bootstrap-5',
            placeholder: "Rol seçiniz",
            allowClear: true
        });
    });
</script>
