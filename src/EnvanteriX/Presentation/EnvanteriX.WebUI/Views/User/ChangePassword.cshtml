@model ChangePasswordViewModel
@{
    ViewData["Title"] = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">
            <div class="card-body">
                <h1 class="mb-4 card-title">Kullanıcı Bilgilerini Güncelleyebilirsiniz.</h1>
                @using (Html.BeginForm("ChangePassword", "User", FormMethod.Post, new { @action = "/User/ChangePassword" }))
                {
                    <div class="row mb-3">
                        <label for="Id" class="col-sm-2 col-form-label">Kullanıcı Id</label>
                        <div class="col-sm-10">
                            <input type="hidden" asp-for="Id" />
                            <label class="form-control" id="Id" asp-for="Id">@Model.Id </label>
                        </div>
                    </div>
                    
                <div class="row mb-3">
                    <label for="Password" class="col-sm-2 col-form-label">Şifre</label>
                    <div class="col-sm-10">
                        @Html.PasswordFor(model => model.Password, new {
                                                @class = "form-control",
                                                type = "password",
                                                placeholder = "Şifrenizi girin"
                                                })
                    </div>
                </div>
                <div class="row mb-3">
                    <label for="ConfirmPassword" class="col-sm-2 col-form-label">Şifre Doğrulama</label>
                    <div class="col-sm-10">
                        @Html.PasswordFor(model => model.ConfirmPassword, new {
                                                @class = "form-control",
                                                type = "Password",
                                                placeholder = "Şifrenizi tekrar girin"
                                                })
                    </div>
                </div>
               

                <div class="row mb-3 mt-4">
                    <div class="col-12 text-center">
                        <button type="submit" class="btn btn-lg btn-primary me-2">Kaydet</button>
                        <button type="button" class="btn btn-lg btn-secondary" onclick="history.back();">Geri Dön</button>
                    </div>
                </div>
                                }
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function() {
        $('#roleSelect').select2({
             theme: 'bootstrap-5',
            placeholder: "Rol seçiniz",
            allowClear: true
        });
    });
</script>
