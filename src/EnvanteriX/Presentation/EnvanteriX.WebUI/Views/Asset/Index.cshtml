@model List<AssetViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12">
    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center">
                <h4 class="card-title">Varlık Listesi</h4>
                <button class="btn btn-primary btn-round ms-auto" onclick="window.location.href='/Asset/Add';">
                    <i class="fa fa-plus"></i>
                    Yeni Varlık Ekle
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="multi-filter-select"
                       class="display table table-striped table-hover text-center">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Tag</th>
                            <th>Seri No</th>
                            <th>Varlık Tipi</th>
                            <th>Marka</th>
                            <th>Model</th>
                            <th>Tedarikçi</th>
                            <th>Lokasyon</th>
                            <th>Satın Alma Tarihi</th>
                            <th>Garanti Bitiş Tarihi</th>
                            <th>Atanan Personel</th>
                            <th>Statüsü</th>
                            <th>Açıklama</th>
                            <th>Oluşturma Tarihi</th>
                            <th>Aktif Mi</th>
                            <th style="width: 15%">İşlemler</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>Id</th>
                            <th>Tag</th>
                            <th>Seri No</th>
                            <th>Varlık Tipi</th>
                            <th>Marka</th>
                            <th>Model</th>
                            <th>Tedarikçi</th>
                            <th>Lokasyon</th>
                            <th>Satın Alma Tarihi</th>
                            <th>Garanti Bitiş Tarihi</th>
                            <th>Atanan Personel</th>
                            <th>Statüsü</th>
                            <th>Açıklama</th>
                            <th>Oluşturma Tarihi</th>
                            <th>Aktif Mi</th>
                            <th>İşlemler</th>
                        </tr>
                    </tfoot>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.Id</td>
                                <td>@item.AssetTag</td>
                                <td>@item.TypeName</td>
                                <td>@item.SerialNumber</td>
                                <td>@item.BrandName</td>
                                <td>@item.ModelName</td>
                                <td>@item.VendorName</td>
                                <td>@item.LocationName</td>
                                <td>@item.PurchaseDate</td>
                                <td>@item.WarrantyEndDate</td>
                                <td>@item.AssignedUserName</td>
                                <td>@item.Status</td>
                                <td>@item.Description</td>
                                <td>@item.CreatedDate</td>
                                <td>
                                    @if (!item.IsDeleted)
                                    {
                                        <i class="fa fa-check"></i> <!-- "tick" simgesi -->
                                    }
                                    else
                                    {
                                        <i class="fa fa-times"></i> <!-- "x" simgesi -->
                                    }
                                </td>
                                <td>
                                   <div class="d-flex gap-2">
                                        <!-- Edit Button -->
                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                data-bs-toggle="tooltip"
                                                title="Edit"
                                                onclick="window.location.href='@Url.Content("~/Asset/Edit/" + item.Id)';">
                                            <i class="fa fa-edit"></i>
                                        </button>

                                        <!-- Active / DeActive Button -->
                                        @if (!item.IsDeleted)
                                        {
                                            <button type="button"
                                                    class="btn btn-danger btn-sm confirm-btn"
                                                    data-bs-toggle="tooltip"
                                                    title="DeActive"
                                                    data-url="@Url.Content("~/Asset/DeActive/" + item.Id)">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-success btn-sm confirm-btn"
                                                    data-bs-toggle="tooltip"
                                                    title="Active"
                                                    data-url="@Url.Content("~/Asset/Active/" + item.Id)">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        }

                                        <!-- Remove Button -->
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm confirm-btn"
                                                data-bs-toggle="tooltip"
                                                title="Remove"
                                                data-url="@Url.Content("~/Asset/Remove/" + item.Id)">
                                            <i class="fa fa-trash-alt"></i>
                                        </button>

                                       
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
