@model UpdateVendorViewModel
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">
            <div class="card-body">
                <h1 class="mb-4 card-title">Tedarikçi Bilgilerini Güncelleyebilirsiniz.</h1>
                @using (Html.BeginForm("Edit", "Vendor", FormMethod.Post, new { @action = "/Vendor/Edit" }))
                {
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Şirket Adı</label>
                        <div class="col-sm-10">
                            <input type="hidden" asp-for="Id" />
                            <label class="form-control" id="Id" asp-for="Id">@Model.Id </label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Tedarikçi Adı</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.VendorName, new { @class = "form-control", type = "text", placeholder = "Tedarikçi Adını Girin" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Personel Adı</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.ContactPerson, new { @class = "form-control", type = "text", placeholder = "Personel Adını Girin" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="PhoneNumber" class="col-sm-2 col-form-label">Telefon Numarası</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.PhoneNumber, new {
                            @class = "form-control",
                                                type = "tel",
                                                placeholder = "Telefon Numarası Girin",
                                                pattern = "[0-9]{10,15}", // opsiyonel: 10-15 rakam
                                                title = "Sadece rakam girin"
                                                })
                    </div>
                </div>

                <div class="row mb-3">
                    <label for="Email" class="col-sm-2 col-form-label">Mail</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(model => model.Email, new {
                                                @class = "form-control",
                                                type = "email",
                                                placeholder = "Mail adresinizi girin"
                                                })
                    </div>
                </div>

                <div class="row mb-3 mt-4">
                    <div class="col-12 text-center">
                        <button type="submit" class="btn btn-lg btn-primary me-2">Kaydet</button>
                        <button type="button" class="btn btn-lg btn-secondary" onclick="history.back();">Geri Dön</button>
                    </div>
                </div>
                                }
            </div>
        </div>
    </div>
</div>


