@model List<Portal365ViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12">
    <div class="card">
        <div class="card-header bg-light d-flex align-items-center justify-content-between">
    <h4 class="card-title mb-0">
        <i class="fa fa-link text-primary me-2"></i> Portal 365 Entegrasyon Listesi
    </h4>

    <div class="d-flex gap-2">
        <button class="btn btn-success btn-sm"
                onclick="navigateWithLoading('/Portal365/Add');"
                data-bs-toggle="tooltip"
                title="Yeni Entegrasyon Ekle">
            <i class="fa fa-plus me-1"></i> Yeni Entegrasyon
        </button>

        <button type="button"
                class="btn btn-danger btn-sm confirm-btn"
                data-bs-toggle="tooltip"
                title="Senkronizasyonu Başlat"
                data-url="@Url.Content("~/Portal365/Sync/")">
            <i class="fa fa-plug me-1"></i> Senkronizasyonu Başlat
        </button>
    </div>
</div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="multi-filter-select"
                       class="display table table-striped table-hover text-center">
                    <thead>
                        <tr>
                            <th>Id</th>
                             <th>TenantId</th>
                            <th>ClientId</th>
                            <th>ClientSecret</th>
                            <th>SenderEmail</th>
                            <th>Oluşturma Tarihi</th>
                            <th>Aktif Mi</th>
                            <th style="width: 15%">İşlemler</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>Id</th>
                            <th>TenantId</th>
                            <th>ClientId</th>
                            <th>ClientSecret</th>
                            <th>SenderEmail</th>
                            <th>Oluşturma Tarihi</th>
                            <th>Aktif Mi</th>
                            <th>İşlemler</th>
                        </tr>
                    </tfoot>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.Id</td>
                                <td>@item.TenantId</td>
                                <td>@item.ClientId</td>
                                <td>@item.ClientSecret</td>
                                <td>@item.SenderEmail</td>
                                <td>@item.CreatedDate</td>
                                <td>
                                    @if (!item.IsDeleted)
                                    {
                                        <i class="fa fa-check"></i> <!-- "tick" simgesi -->
                                    }
                                    else
                                    {
                                        <i class="fa fa-times"></i> <!-- "x" simgesi -->
                                    }
                                </td>
                                <td>
                                   <div class="d-flex gap-2">
                                        <!-- Edit Button -->
                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                data-bs-toggle="tooltip"
                                                title="Edit"
                                                onclick="navigateWithLoading('@Url.Content("~/Portal365/Edit/" + item.Id)');">
                                            <i class="fa fa-edit"></i>
                                        </button>


                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                data-bs-toggle="tooltip"
                                                title="TestConnection"
                                                onclick="navigateWithLoading('@Url.Content("~/Portal365/TestConnection/" + item.Id)');">
                                            <i class="fa fa-plug"></i>
                                        </button>

                                        <!-- Active / DeActive Button -->
                                        @if (!item.IsDeleted)
                                        {
                                            <button type="button"
                                                    class="btn btn-danger btn-sm confirm-btn"
                                                    data-bs-toggle="tooltip"
                                                    title="DeActive"
                                                    data-url="@Url.Content("~/Portal365/DeActive/" + item.Id)">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-success btn-sm confirm-btn"
                                                    data-bs-toggle="tooltip"
                                                    title="Active"
                                                    data-url="@Url.Content("~/Portal365/Active/" + item.Id)">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        }

                                        <!-- Remove Button -->
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm confirm-btn"
                                                data-bs-toggle="tooltip"
                                                title="Remove"
                                                data-url="@Url.Content("~/Portal365/Remove/" + item.Id)">
                                            <i class="fa fa-trash-alt"></i>
                                        </button>

                                       
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
