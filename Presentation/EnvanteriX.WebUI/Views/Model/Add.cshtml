@model CreateModelViewModel
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">
            <div class="card-body">
                <h1 class="mb-4 card-title">Yeni Model Bilgilerini Giriniz.</h1>
                @using (Html.BeginForm("Add", "Model", FormMethod.Post))
                {
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Model Adı</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.ModelName, new { @class = "form-control", type = "text", placeholder = "Model Adını Girin" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="ModelName" class="col-sm-2 col-form-label">Marka Adı</label>
                        <div class="col-sm-10">
                            @Html.DropDownList("BrandId", ViewBag.Brands as SelectList, new { @class = " select2 form-control", id = "brandSelect" })
                        </div>
                    </div>
                    <div class="row mb-3 mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-lg btn-primary me-2">Kaydet</button>
                            <button type="button" class="btn btn-lg btn-secondary" onclick="history.back();">Geri Dön</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        $('#brandSelect').select2({
             theme: 'bootstrap-5',
            placeholder: "Marka seçiniz",
            allowClear: true
        });
    });
</script>
