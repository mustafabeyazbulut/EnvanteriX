@model UpdateModelViewModel
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">
            <div class="card-body">
                <h1 class="mb-4 card-title">Model Bilgilerini Güncelleyebilirsiniz.</h1>
                @using (Html.BeginForm("Edit", "Model", FormMethod.Post, new { @action = "/Model/Edit" }))
                {
                    <div class="row mb-3">
                        <label for="Id" class="col-sm-2 col-form-label">Şirket Adı</label>
                        <div class="col-sm-10">
                            <input type="hidden" asp-for="Id" />
                            <label class="form-control" id="Id" asp-for="Id">@Model.Id </label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="ModelName" class="col-sm-2 col-form-label">Model Adı</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.ModelName, new { @class = "form-control", type = "text", placeholder = "Model Adını Girin" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="ModelName" class="col-sm-2 col-form-label">Marka Adı</label>
                        <div class="col-sm-10">
                            @Html.DropDownList("BrandId", ViewBag.Brands as SelectList, new { @class = " select2 form-control", id = "brandSelect" })
                        </div>
                    </div>

                <div class="row mb-3 mt-4">
                    <div class="col-12 text-center">
                        <button type="submit" class="btn btn-lg btn-primary me-2">Kaydet</button>
                        <button type="button" class="btn btn-lg btn-secondary" onclick="goBack()">Geri Dön</button>
                    </div>
                </div>
                                }
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function() {
        $('#brandSelect').select2({
             theme: 'bootstrap-5',
            placeholder: "Marka seçiniz",
            allowClear: true
        });
    });
</script>