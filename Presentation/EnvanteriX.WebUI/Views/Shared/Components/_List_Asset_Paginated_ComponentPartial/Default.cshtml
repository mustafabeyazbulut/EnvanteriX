@using EnvanteriX.WebUI.ViewModels.Asset
@model PaginatedAssetViewModel
@using EnvanteriX.WebUI.Enums

@{
    // Model null ise default değer kullan
    var viewModel = Model ?? new PaginatedAssetViewModel();
    
    var currentFilters = new Dictionary<string, string>();
    if (Context.Request.Query.ContainsKey("searchTerm"))
        currentFilters["searchTerm"] = Context.Request.Query["searchTerm"].ToString();
    if (Context.Request.Query.ContainsKey("assetTypeId"))
        currentFilters["assetTypeId"] = Context.Request.Query["assetTypeId"].ToString();
    if (Context.Request.Query.ContainsKey("brandId"))
        currentFilters["brandId"] = Context.Request.Query["brandId"].ToString();
    if (Context.Request.Query.ContainsKey("modelId"))
        currentFilters["modelId"] = Context.Request.Query["modelId"].ToString();
    if (Context.Request.Query.ContainsKey("locationId"))
        currentFilters["locationId"] = Context.Request.Query["locationId"].ToString();
    if (Context.Request.Query.ContainsKey("status"))
        currentFilters["status"] = Context.Request.Query["status"].ToString();
    if (Context.Request.Query.ContainsKey("isRented"))
        currentFilters["isRented"] = Context.Request.Query["isRented"].ToString();
    if (Context.Request.Query.ContainsKey("isDeleted"))
        currentFilters["isDeleted"] = Context.Request.Query["isDeleted"].ToString();
    if (Context.Request.Query.ContainsKey("assignedUserId"))
        currentFilters["assignedUserId"] = Context.Request.Query["assignedUserId"].ToString();
    if (Context.Request.Query.ContainsKey("assignedDepartmentId"))
        currentFilters["assignedDepartmentId"] = Context.Request.Query["assignedDepartmentId"].ToString();
}

<div class="col-md-12">
    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="card-title mb-0">Varlık Listesi (Sayfalama)</h4>
                <button class="btn btn-primary btn-round" onclick="navigateWithLoading('/Asset/Add');">
                    <i class="fa fa-plus"></i>
                    Yeni Varlık Ekle
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Filtreleme Bölümü -->
            <div class="filter-section mb-4">
                <form id="filterForm" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Arama</label>
                        <input type="text" 
                               class="form-control" 
                               id="searchTerm" 
                               name="searchTerm" 
                               placeholder="Tag veya Seri No ara..."
                               value="@(currentFilters.ContainsKey("searchTerm") ? currentFilters["searchTerm"] : "")">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Varlık Tipi</label>
                        <select class="form-select" id="assetTypeId" name="assetTypeId">
                            <option value="">Tümü</option>
                            @if (ViewBag.AssetTypes != null)
                            {
                                foreach (var item in ViewBag.AssetTypes as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                {
                                    var isSelected = currentFilters.ContainsKey("assetTypeId") && currentFilters["assetTypeId"] == item.Value;
                                    <option value="@item.Value" selected="@isSelected">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Marka</label>
                        <select class="form-select" id="brandId" name="brandId">
                            <option value="">Tümü</option>
                            @if (ViewBag.Brands != null)
                            {
                                foreach (var item in ViewBag.Brands as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                {
                                    var isSelected = currentFilters.ContainsKey("brandId") && currentFilters["brandId"] == item.Value;
                                    <option value="@item.Value" selected="@isSelected">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Model</label>
                        <select class="form-select" id="modelId" name="modelId">
                            <option value="">Tümü</option>
                            @if (ViewBag.Models != null)
                            {
                                foreach (var item in ViewBag.Models as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                {
                                    var isSelected = currentFilters.ContainsKey("modelId") && currentFilters["modelId"] == item.Value;
                                    <option value="@item.Value" selected="@isSelected">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Lokasyon</label>
                        <select class="form-select" id="locationId" name="locationId">
                            <option value="">Tümü</option>
                            @if (ViewBag.Locations != null)
                            {
                                foreach (var item in ViewBag.Locations as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                {
                                    var isSelected = currentFilters.ContainsKey("locationId") && currentFilters["locationId"] == item.Value;
                                    <option value="@item.Value" selected="@isSelected">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Atanan Personel</label>
                        <select class="form-select select2" id="assignedUserId" name="assignedUserId">
                            <option value="">Tümü</option>
                            @if (ViewBag.Users != null)
                            {
                                foreach (var item in ViewBag.Users as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                {
                                    var isSelected = currentFilters.ContainsKey("assignedUserId") && currentFilters["assignedUserId"] == item.Value;
                                    <option value="@item.Value" selected="@isSelected">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Atanan Departman</label>
                        <select class="form-select select2" id="assignedDepartmentId" name="assignedDepartmentId">
                            <option value="">Tümü</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var item in ViewBag.Departments as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                {
                                    var isSelected = currentFilters.ContainsKey("assignedDepartmentId") && currentFilters["assignedDepartmentId"] == item.Value;
                                    <option value="@item.Value" selected="@isSelected">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Statü</label>
                        <select class="form-select" id="status" name="status">
                            <option value="">Tümü</option>
                            @foreach (StatusEnum statusValue in Enum.GetValues(typeof(StatusEnum)).Cast<StatusEnum>().Where(s => s != StatusEnum.None))
                            {
                                var isSelected = currentFilters.ContainsKey("status") && currentFilters["status"] == statusValue.ToString();
                                <option value="@statusValue.ToString()" selected="@isSelected">@statusValue.ToString()</option>
                            }
                            @{
                                var isPasifSelected = currentFilters.ContainsKey("isDeleted") && currentFilters["isDeleted"] == "true";
                            }
                            <option value="Pasif" selected="@isPasifSelected">Pasif (Hurda)</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Kiralık</label>
                        <select class="form-select" id="isRented" name="isRented">
                            <option value="">Tümü</option>
                            @{
                                var isRentedTrue = currentFilters.ContainsKey("isRented") && currentFilters["isRented"] == "true";
                                var isRentedFalse = currentFilters.ContainsKey("isRented") && currentFilters["isRented"] == "false";
                            }
                            <option value="true" selected="@isRentedTrue">Evet</option>
                            <option value="false" selected="@isRentedFalse">Hayır</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-filter"></i> Filtrele
                            </button>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-secondary" onclick="clearFilters()">
                                <i class="fa fa-times"></i> Temizle
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Sayfa Boyutu ve Bilgi -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <label class="me-2">Sayfa Başına:</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm d-inline-block" style="width: auto;">
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    </select>
                </div>
                <div>
                    <strong>Toplam @Model.TotalCount kayıt</strong> (Sayfa @Model.PageNumber / @Model.TotalPages)
                </div>
            </div>

            <!-- Tablo -->
            <div class="table-responsive">
                <table class="table table-striped table-hover text-center">
                    <thead class="table-light">
                        <tr>
                            <th>Tag</th>
                            <th>Seri No</th>
                            <th>Varlık Tipi</th>
                            <th>Marka</th>
                            <th>Model</th>
                            <th>Lokasyon</th>
                            <th>Atanan Personel</th>
                            <th>Atanan Departman</th>
                            <th>Statüsü</th>
                            <th>Kiralık Mı</th>
                            <th>Aktif Mi</th>
                            <th style="width: 15%">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.AssetTag</td>
                                    <td>@item.SerialNumber</td>
                                    <td>@item.TypeName</td>
                                    <td>@item.BrandName</td>
                                    <td>@item.ModelName</td>
                                    <td>@item.LocationName</td>
                                    <td>@item.AssignedUserName</td>
                                    <td>@item.AssignedDepartmentName</td>
                                    <td>@item.Status</td>
                                    <td class="text-center">
                                        @if (item.IsRented)
                                        {
                                            <i class="fas fa-handshake text-warning" title="Kiralık"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-box text-success" title="Satın Alınmış"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (!item.IsDeleted)
                                        {
                                            <i class="fa fa-check text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fa fa-times text-danger"></i>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 justify-content-center">
                                            <button type="button"
                                                    class="btn btn-info btn-sm"
                                                    data-bs-toggle="tooltip"
                                                    title="Detaylar"
                                                    onclick="navigateWithLoading('@Url.Content("~/Asset/Details/" + item.Id)');">
                                                <i class="fa fa-eye"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-success btn-sm"
                                                    data-bs-toggle="tooltip"
                                                    title="Atama Yap"
                                                    onclick="navigateWithLoading('@Url.Content("~/Asset/Assign/" + item.Id)');">
                                                <i class="fa fa-user-plus"></i>
                                            </button>

                                            @if (item.Status == StatusEnum.Tamirde.ToString())
                                            {
                                                <button type="button"
                                                        class="btn btn-warning btn-sm"
                                                        data-bs-toggle="tooltip"
                                                        title="Tamirden Geldi"
                                                        onclick="navigateWithLoading('@Url.Content("~/MaintenanceRecord/AssignAfterRepair/" + item.Id)')">
                                                    <i class="fa fa-wrench"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-warning btn-sm"
                                                        data-bs-toggle="tooltip"
                                                        title="Bakım/Tamire Gönder"
                                                        onclick="navigateWithLoading('@Url.Content("~/MaintenanceRecord/SendToMaintenance/" + item.Id)')">
                                                    <i class="fa fa-wrench"></i>
                                                </button>
                                            }

                                            @if (item.Status == StatusEnum.KullanimDisi.ToString())
                                            {
                                                <button type="button"
                                                        class="btn btn-success btn-sm"
                                                        data-bs-toggle="tooltip"
                                                        title="Stoğa Geri Çek"
                                                        onclick="navigateWithLoading('@Url.Content("~/Asset/SendToStock/" + item.Id)')">
                                                    <i class="fa fa-box"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-secondary btn-sm"
                                                        data-bs-toggle="tooltip"
                                                        title="Kullanım Dışı İşaretle"
                                                        onclick="navigateWithLoading('@Url.Content("~/Asset/SendToDeactivate/" + item.Id)')">
                                                    <i class="fa fa-ban"></i>
                                                </button>
                                            }

                                            @if (!item.IsDeleted)
                                            {
                                                <button type="button"
                                                        class="btn btn-danger btn-sm confirm-btn"
                                                        data-bs-toggle="tooltip"
                                                        title="Pasif Yap"
                                                        data-url="@Url.Content("~/Asset/DeActive/" + item.Id)">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-success btn-sm confirm-btn"
                                                        data-bs-toggle="tooltip"
                                                        title="Aktif Yap"
                                                        data-url="@Url.Content("~/Asset/Active/" + item.Id)">
                                                    <i class="fa fa-check"></i>
                                                </button>
                                            }

                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm confirm-btn"
                                                    data-bs-toggle="tooltip"
                                                    title="Sil"
                                                    data-url="@Url.Content("~/Asset/Remove/" + item.Id)">
                                                <i class="fa fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="12" class="text-center py-4">
                                    <i class="fa fa-inbox fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">Kayıt bulunamadı</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sayfalama Kontrolleri -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Sayfa navigasyonu">
                    <ul class="pagination justify-content-center">
                        <!-- Önceki Sayfa -->
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="changePage(@(Model.PageNumber - 1)); return false;">
                                <i class="fa fa-chevron-left"></i> Önceki
                            </a>
                        </li>

                        <!-- Sayfa Numaraları -->
                        @{
                            int startPage = Math.Max(1, Model.PageNumber - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);

                            if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="#" onclick="changePage(1); return false;">1</a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="#" onclick="changePage(@i); return false;">@i</a>
                                </li>
                            }

                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="#" onclick="changePage(@Model.TotalPages); return false;">@Model.TotalPages</a>
                                </li>
                            }
                        }

                        <!-- Sonraki Sayfa -->
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="changePage(@(Model.PageNumber + 1)); return false;">
                                Sonraki <i class="fa fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#assignedUserId').select2({
            theme: 'bootstrap-5',
            placeholder: 'Tüm Personel',
            allowClear: true,
            width: '100%'
        });
        $('#assignedDepartmentId').select2({
            theme: 'bootstrap-5',
            placeholder: 'Tüm Departmanlar',
            allowClear: true,
            width: '100%'
        });
    });

    // Filtre formunu gönder
    document.getElementById('filterForm').addEventListener('submit', function(e) {
        e.preventDefault();
        applyFilters();
    });

    // Sayfa boyutu değiştiğinde
    document.getElementById('pageSizeSelect').addEventListener('change', function() {
        applyFilters(1); // Sayfa boyutu değişince 1. sayfaya dön
    });

    // Marka değiştiğinde modelleri güncelle
    document.getElementById('brandId').addEventListener('change', function() {
        var brandId = this.value;
        if (brandId) {
            fetch('/Asset/GetModelsByBrand?brandId=' + brandId)
                .then(response => response.json())
                .then(data => {
                    var modelSelect = document.getElementById('modelId');
                    modelSelect.innerHTML = '<option value="">Tümü</option>';
                    data.forEach(function(model) {
                        var option = document.createElement('option');
                        option.value = model.id;
                        option.text = model.modelName;
                        modelSelect.appendChild(option);
                    });
                });
        } else {
            document.getElementById('modelId').innerHTML = '<option value="">Tümü</option>';
        }
    });

    function applyFilters(pageNumber) {
        var params = new URLSearchParams();
        params.append('pageNumber', pageNumber || 1);
        params.append('pageSize', document.getElementById('pageSizeSelect').value);

        var searchTerm = document.getElementById('searchTerm').value;
        if (searchTerm) params.append('searchTerm', searchTerm);

        var assetTypeId = document.getElementById('assetTypeId').value;
        if (assetTypeId) params.append('assetTypeId', assetTypeId);

        var brandId = document.getElementById('brandId').value;
        if (brandId) params.append('brandId', brandId);

        var modelId = document.getElementById('modelId').value;
        if (modelId) params.append('modelId', modelId);

        var locationId = document.getElementById('locationId').value;
        if (locationId) params.append('locationId', locationId);

        var status = document.getElementById('status').value;
        if (status === 'Pasif') {
            params.append('isDeleted', 'true');
        } else if (status) {
            params.append('status', status);
        }

        var isRented = document.getElementById('isRented').value;
        if (isRented) params.append('isRented', isRented);

        var assignedUserId = document.getElementById('assignedUserId').value;
        if (assignedUserId) params.append('assignedUserId', assignedUserId);

        var assignedDepartmentId = document.getElementById('assignedDepartmentId').value;
        if (assignedDepartmentId) params.append('assignedDepartmentId', assignedDepartmentId);

        window.location.href = '/Asset/Paginated?' + params.toString();
    }

    function changePage(pageNumber) {
        applyFilters(pageNumber);
    }

    function clearFilters() {
        window.location.href = '/Asset/Paginated';
    }
</script>
