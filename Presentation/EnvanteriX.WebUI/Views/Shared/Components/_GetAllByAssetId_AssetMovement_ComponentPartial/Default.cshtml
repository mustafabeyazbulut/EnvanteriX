@model List<AssetMovementViewModel>

<div class=" mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fa fa-exchange-alt me-2"></i>Varlık Hareketleri</h4>
           @*  <a href="@Url.Action("Create", "AssetMovement")" class="btn btn-light btn-sm">
                <i class="fa fa-plus me-1"></i>Yeni Hareket Ekle
            </a> *@
        </div>
        <div class="card-body  p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                @* <th>Varlık Adı</th> *@
                                <th>Gönderen Kullanıcı</th>
                                <th>Alan Kullanıcı</th>
                                <th>Kaynak Lokasyon</th>
                                <th>Hedef Lokasyon</th>
                                <th>Not</th>
                                <th>Tarih</th>
                                @* <th>İşlemler</th> *@
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    @* <td>@(item.AssetName ?? "-")</td> *@
                                    <td>@(item.FromUserFullName ?? "-")</td>
                                    <td>@(item.ToUserFullName ?? "-")</td>
                                    <td>@(item.FromLocationName ?? "-")</td>
                                    <td>@(item.ToLocationName ?? "-")</td>

                                    <td>@item.Note</td>
                                    <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                   @*  <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="@Url.Action("Details", "AssetMovement", new { id = item.Id })"
                                               class="btn btn-sm btn-outline-info" title="Detay">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", "AssetMovement", new { id = item.Id })"
                                               class="btn btn-sm btn-outline-warning" title="Düzenle">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", "AssetMovement", new { id = item.Id })"
                                               class="btn btn-sm btn-outline-danger" title="Sil"
                                               onclick="return confirm('Bu hareketi silmek istediğinize emin misiniz?');">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    </td> *@
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center mb-0">
                    Henüz herhangi bir varlık hareketi bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>
