@using EnvanteriX.WebUI.ViewModels.MaintenanceRecord
@using EnvanteriX.WebUI.Enums
@model PaginatedMaintenanceRecordViewModel

@{
    var viewModel = Model ?? new PaginatedMaintenanceRecordViewModel();
    
    var currentFilters = new Dictionary<string, string>();
    if (Context.Request.Query.ContainsKey("searchTerm"))
        currentFilters["searchTerm"] = Context.Request.Query["searchTerm"].ToString();
    if (Context.Request.Query.ContainsKey("assetId"))
        currentFilters["assetId"] = Context.Request.Query["assetId"].ToString();
    if (Context.Request.Query.ContainsKey("vendorId"))
        currentFilters["vendorId"] = Context.Request.Query["vendorId"].ToString();
    if (Context.Request.Query.ContainsKey("startDateFrom"))
        currentFilters["startDateFrom"] = Context.Request.Query["startDateFrom"].ToString();
    if (Context.Request.Query.ContainsKey("startDateTo"))
        currentFilters["startDateTo"] = Context.Request.Query["startDateTo"].ToString();
    if (Context.Request.Query.ContainsKey("isCompleted"))
        currentFilters["isCompleted"] = Context.Request.Query["isCompleted"].ToString();
}

<div class="col-md-12">
    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="card-title mb-0">Bakım Kayıtları</h4>
                <a href="@Url.Action("SendToMaintenance", "MaintenanceRecord", new { assetId = 0 })" class="btn btn-primary btn-round disabled">
                    <i class="fa fa-plus"></i>
                    Yeni Bakım (Varlık Seçerek Yapınız)
                </a>
            </div>
        </div>

        <div class="card-body">
            <!-- Filtreleme Bölümü -->
            <div class="filter-section mb-4">
                <form id="filterForm" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Arama</label>
                        <input type="text" 
                               class="form-control" 
                               id="searchTerm" 
                               name="searchTerm" 
                               placeholder="Varlık, Açıklama vb. ara..."
                               value="@(currentFilters.ContainsKey("searchTerm") ? currentFilters["searchTerm"] : "")">
                    </div>
                    
                    <div class="col-md-3">
                        <label class="form-label">Tedarikçi</label>
                        <select id="vendorId" name="vendorId" class="form-select select2">
                            <option value="">Tümü</option>
                            @if (Model.Vendors != null)
                            {
                                foreach (var vendor in Model.Vendors)
                                {
                                    <option value="@vendor.Value" selected="@vendor.Selected">@vendor.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Başlangıç Tarihi (Min)</label>
                        <input type="date" class="form-control" id="startDateFrom" name="startDateFrom" 
                               value="@(currentFilters.ContainsKey("startDateFrom") ? currentFilters["startDateFrom"] : "")">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Başlangıç Tarihi (Max)</label>
                        <input type="date" class="form-control" id="startDateTo" name="startDateTo" 
                               value="@(currentFilters.ContainsKey("startDateTo") ? currentFilters["startDateTo"] : "")">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Durum</label>
                        <select id="isCompleted" name="isCompleted" class="form-select">
                            <option value="">Tümü</option>
                            <option value="false" selected="@(currentFilters.ContainsKey("isCompleted") && currentFilters["isCompleted"] == "false")">Devam Eden</option>
                            <option value="true" selected="@(currentFilters.ContainsKey("isCompleted") && currentFilters["isCompleted"] == "true")">Tamamlanan</option>
                        </select>
                    </div>

                    <div class="col-12 text-end mt-3">
                        <button type="button" class="btn btn-secondary me-2" onclick="clearFilters()">
                            <i class="fa fa-eraser"></i> Temizle
                        </button>
                        <button type="button" class="btn btn-primary" onclick="applyFilters()">
                            <i class="fa fa-filter"></i> Filtrele
                        </button>
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <label class="me-2">Sayfa Başına:</label>
                        <select id="pageSizeSelect" class="form-select form-select-sm d-inline-block" style="width: auto;">
                            <option value="10" selected="@(viewModel.PageSize == 10)">10</option>
                            <option value="25" selected="@(viewModel.PageSize == 25)">25</option>
                            <option value="50" selected="@(viewModel.PageSize == 50)">50</option>
                            <option value="100" selected="@(viewModel.PageSize == 100)">100</option>
                        </select>
                    </div>
                    <div>
                        <strong>Toplam @viewModel.TotalCount kayıt</strong> (Sayfa @viewModel.PageNumber / @viewModel.TotalPages)
                    </div>
                </div>

                <table class="table table-striped table-hover">
                    <thead class="text-primary">
                        <tr>
                            <th>ID</th>
                            <th>Varlık</th>
                            <th>Tedarikçi</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Süre</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (viewModel.Items != null && viewModel.Items.Any())
                        {
                            foreach (var item in viewModel.Items.OrderByDescending(y=>y.Id))
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        <div><strong>@item.AssetName</strong></div>
                                        <small class="text-muted">@item.AssetTypeName</small>
                                        @if (!string.IsNullOrEmpty(item.LocationName) && item.LocationName != "-")
                                        {
                                            <br/><small class="text-info"><i class="fa fa-map-marker"></i> @item.LocationName</small>
                                        }
                                        @if (!string.IsNullOrEmpty(item.AssetTag))
                                        {
                                            <br/><small class="badge bg-light text-dark border">Tag: @item.AssetTag</small>
                                        }
                                    </td>
                                    <td>@item.VendorName</td>
                                    <td>@item.StartDate.ToShortDateString()</td>
                                    <td>@(item.EndDate.HasValue ? item.EndDate.Value.ToShortDateString() : "-")</td>
                                    <td>@(item.DurationDays.HasValue ? $"{item.DurationDays} gün" : "-")</td>
                                    <td>
                                        @if (item.IsCompleted)
                                        {
                                            <span class="badge bg-success">Tamamlandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Devam Ediyor</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a href="@Url.Action("Details", "MaintenanceRecord", new { id = item.Id })" 
                                               class="btn btn-sm btn-info text-white" title="Detaylar">
                                                <i class="fa fa-info-circle"></i>
                                            </a>
                                            @if (!item.IsCompleted)
                                            {
                                                <a href="@Url.Action("AssignAfterRepair", "MaintenanceRecord", new { assetId = item.AssetId })" 
                                                   class="btn btn-sm btn-success" title="Bakımı Tamamla">
                                                    <i class="fa fa-check"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="fa fa-info-circle fa-2x mb-3"></i>
                                        <p>Kayıt bulunamadı.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sayfalama Kontrolleri -->
            @if (viewModel.TotalPages > 1)
            {
                <nav aria-label="Sayfa navigasyonu">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(!viewModel.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="changePage(@(viewModel.PageNumber - 1)); return false;">
                                <i class="fa fa-chevron-left"></i> Önceki
                            </a>
                        </li>

                        @{
                            int startPage = Math.Max(1, viewModel.PageNumber - 2);
                            int endPage = Math.Min(viewModel.TotalPages, viewModel.PageNumber + 2);

                            if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="#" onclick="changePage(1); return false;">1</a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == viewModel.PageNumber ? "active" : "")">
                                    <a class="page-link" href="#" onclick="changePage(@i); return false;">@i</a>
                                </li>
                            }

                            if (endPage < viewModel.TotalPages)
                            {
                                if (endPage < viewModel.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="#" onclick="changePage(@viewModel.TotalPages); return false;">@viewModel.TotalPages</a>
                                </li>
                            }
                        }

                        <li class="page-item @(!viewModel.HasNextPage ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="changePage(@(viewModel.PageNumber + 1)); return false;">
                                Sonraki <i class="fa fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Vendor dropdown doldurma (eğer API varsa)
        // loadVendors();
        
        // Sayfa boyutu değişikliği
        document.getElementById('pageSizeSelect').addEventListener('change', function() {
            applyFilters(1);
        });
        
        // Enter tuşu ile arama
        document.getElementById('filterForm').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                applyFilters(1);
            }
        });
    });

    function getFilterParams(pageNumber = 1) {
        const pageSize = document.getElementById('pageSizeSelect').value;
        const searchTerm = document.getElementById('searchTerm').value;
        const vendorId = document.getElementById('vendorId').value;
        const startDateFrom = document.getElementById('startDateFrom').value;
        const startDateTo = document.getElementById('startDateTo').value;
        const isCompleted = document.getElementById('isCompleted').value;

        let params = new URLSearchParams();
        params.append('pageNumber', pageNumber);
        params.append('pageSize', pageSize);
        
        if (searchTerm) params.append('searchTerm', searchTerm);
        if (vendorId) params.append('vendorId', vendorId);
        if (startDateFrom) params.append('startDateFrom', startDateFrom);
        if (startDateTo) params.append('startDateTo', startDateTo);
        if (isCompleted) params.append('isCompleted', isCompleted);
        
        return params;
    }

    function applyFilters(pageNumber = @viewModel.PageNumber) {
        const params = getFilterParams(pageNumber);
        window.location.href = window.location.pathname + '?' + params.toString();
    }
    
    function changePage(pageNumber) {
        applyFilters(pageNumber);
    }
    
    function clearFilters() {
        window.location.href = window.location.pathname;
    }
</script>
