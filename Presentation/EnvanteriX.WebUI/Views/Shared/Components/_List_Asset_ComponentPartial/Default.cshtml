@model List<AssetViewModel>

<div class="col-md-12">
    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center">
                <h4 class="card-title">Varlık Listesi</h4>
                <button class="btn btn-primary btn-round ms-auto" onclick="navigateWithLoading('/Asset/Add');">
                    <i class="fa fa-plus"></i>
                    Yeni Varlık Ekle
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="multi-filter-select"
                       class="display table table-striped table-hover text-center">
                    <thead>
                        <tr>
                            <th>Tag</th>
                            <th>Seri No</th>
                            <th>Varlık Tipi</th>
                            <th>Marka</th>
                            <th>Model</th>
                            <th>Lokasyon</th>
                            <th>Atanan Personel</th>
                            <th>Atanan Departman</th>
                            <th>Statüsü</th>
                            <th>Kiralık Mı</th>
                            <th>Aktif Mi</th>
                            <th style="width: 15%">İşlemler</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>Tag</th>
                            <th>Seri No</th>
                            <th>Varlık Tipi</th>
                            <th>Marka</th>
                            <th>Model</th>
                            <th>Lokasyon</th>
                            <th>Atanan Personel</th>
                            <th>Atanan Departman</th>
                            <th>Statüsü</th>
                            <th>Kiralık Mı</th>
                            <th>Aktif Mi</th>
                            <th>İşlemler</th>
                        </tr>
                    </tfoot>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.AssetTag</td>
                                <td>@item.SerialNumber</td>
                                <td>@item.TypeName</td>
                                <td>@item.BrandName</td>
                                <td>@item.ModelName</td>
                                <td>@item.LocationName</td>
                                <td>@item.AssignedUserName</td>
                                <td>@item.AssignedDepartmentName</td>
                                <td>@item.Status</td>
                                 <td class="text-center">
                                   @if (item.IsRented)
                                        {
                                            <i class="fas fa-handshake text-warning" title="Kiralık"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-box text-success" title="Satın Alınmış"></i>
                                        }
                                </td>

                                <td>
                                    @if (!item.IsDeleted)
                                    {
                                        <i class="fa fa-check"></i> <!-- "tick" simgesi -->
                                    }
                                    else
                                    {
                                        <i class="fa fa-times"></i> <!-- "x" simgesi -->
                                    }
                                </td>
                                <td>
                                   <div class="d-flex gap-2">

                                       <!-- Detail Button -->
                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                data-bs-toggle="tooltip"
                                                title="Details"
                                                onclick="navigateWithLoading('@Url.Content("~/Asset/Details/" + item.Id)');">
                                            <i class="fa fa-eye"></i>
                                        </button>


                                       @*  <!-- Edit Button -->
                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                data-bs-toggle="tooltip"
                                                title="Edit"
                                                onclick="window.location.href='@Url.Content("~/Asset/Edit/" + item.Id)';">
                                            <i class="fa fa-edit"></i>
                                        </button> *@

                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                data-bs-toggle="tooltip"
                                                title="Atama Yap"
                                                onclick="navigateWithLoading('@Url.Content("~/Asset/Assign/" + item.Id)');">
                                            <i class="fa fa-user-plus"></i>
                                        </button>

                                         @if (item.Status == StatusEnum.Tamirde.ToString())
                                        {
                                             <button type="button"
                                                class="btn btn-warning btn-sm"
                                                data-bs-toggle="tooltip"
                                                title="Tamirden Geldi olarak işaretle"
                                                onclick="navigateWithLoading('@Url.Content("~/MaintenanceRecord/AssignAfterRepair/" + item.Id)')">
                                                    <i class="fa fa-wrench"></i>
                                             </button> 
                                        }else
                                        {
                                            <button type="button"
                                                class="btn btn-warning btn-sm"
                                                data-bs-toggle="tooltip"
                                                title="Bakım / Tamire Gönder"
                                                onclick="navigateWithLoading('@Url.Content("~/MaintenanceRecord/SendToMaintenance/" + item.Id)')">
                                                <i class="fa fa-wrench" ></i>
                                            </button> 
                                        } 
                                        @if (item.Status==StatusEnum.KullanimDisi.ToString())
                                        {
                                                <!-- Stoğa Geri Çek Butonu -->
                                                <button type="button"
                                                        class="btn btn-success btn-sm "
                                                        data-bs-toggle="tooltip"
                                                        title="Stoğa Geri Çek"
                                                        onclick="navigateWithLoading('@Url.Content("~/Asset/SendToStock/" + item.Id)')">
                                                    <i class="fa fa-box"></i>
                                                </button>
                                        }else
                                        {
                                             <!-- Kullanım Dışı Butonu -->
                                                <button type="button"
                                                        class="btn btn-secondary btn-sm"
                                                        data-bs-toggle="tooltip"
                                                        title="Kullanım Dışı İşaretle"
                                                       onclick="navigateWithLoading('@Url.Content("~/Asset/SendToDeactivate/" + item.Id)')">
                                                    <i class="fa fa-ban"></i>
                                                </button>
                                        }
                                       

                                        <!-- Active / DeActive Button -->
                                        @if (!item.IsDeleted)
                                        {
                                            <button type="button"
                                                    class="btn btn-danger btn-sm confirm-btn"
                                                    data-bs-toggle="tooltip"
                                                    title="DeActive"
                                                    data-url="@Url.Content("~/Asset/DeActive/" + item.Id)">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-success btn-sm confirm-btn"
                                                    data-bs-toggle="tooltip"
                                                    title="Active"
                                                    data-url="@Url.Content("~/Asset/Active/" + item.Id)">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        }

                                        <!-- Remove Button -->
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm confirm-btn"
                                                data-bs-toggle="tooltip"
                                                title="Remove"
                                                data-url="@Url.Content("~/Asset/Remove/" + item.Id)">
                                            <i class="fa fa-trash-alt"></i>
                                        </button>

                                       
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
