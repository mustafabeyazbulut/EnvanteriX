@model AssetViewModel

<div class="mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-box-seam me-2"></i> @Model.AssetTag - @Model.ModelName
            </h5>
            <span class="badge bg-light text-dark px-3">@Model.Status</span>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="p-2 border rounded-3 bg-light">
                        <strong>Seri Numarası:</strong> @Model.SerialNumber
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-2 border rounded-3 bg-light">
                        <strong>Tür:</strong> @Model.TypeName
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-2 border rounded-3 bg-light">
                        <strong>Model:</strong> @Model.ModelName
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-2 border rounded-3 bg-light">
                        <strong>Marka:</strong> @Model.BrandName
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-2 border rounded-3 bg-light">
                        <strong>Tedarikçi:</strong> @Model.VendorName
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-2 border rounded-3 bg-light">
                        <strong>Konum:</strong> @Model.LocationName
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-2 border rounded-3 bg-light">
                        <strong>Kullanıcı:</strong> @Model.AssignedUserName
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-2 border rounded-3 bg-light">
                        <strong>Departman:</strong> @Model.AssignedDepartmentName
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-2 border rounded-3 bg-light">
                        <strong>Kiralama Tarihi:</strong> @Model.RentalStartDate
                    </div>
                </div>


                <div class="col-md-12">
                    <div class="p-3 border rounded-3 bg-light">
                        <strong>Açıklama:</strong>
                        <p class="mt-1 mb-0">@Model.Description</p>
                    </div>
                </div>

                <div class="col-md-12 text-end mt-3">
                    <a href="@Url.Action("Index", "Asset")" class="btn btn-outline-secondary me-2">
                        <i class="fa fa-arrow-left"></i> Listeye Dön
                    </a>
                    <a href="@Url.Action("Edit", "Asset", new { id = Model.Id })" class="btn btn-primary">
                        <i class="fa fa-edit"></i> Düzenle
                    </a>
                    <a href="@Url.Action("Assign", "Asset", new { id = Model.Id })" class="btn btn-secondary">
                        <i class="fa fa-user-plus"></i>Atama Yap
                    </a>
                    @if (Model.Status == StatusEnum.Tamirde.ToString())
                    {
                        <a href="@Url.Action("AssignAfterRepair", "MaintenanceRecord", new { assetId = Model.Id })"
                           class="btn btn-success "
                           data-bs-toggle="tooltip"
                           title="Tamirden Geldi olarak işaretle">
                            <i class="fa fa-wrench"></i> Tamirden Geldi
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("SendToMaintenance", "MaintenanceRecord", new { assetId = Model.Id })"
                           class="btn btn-warning"
                           data-bs-toggle="tooltip"
                           title="Bakım / Tamire Gönder">
                            <i class="fa fa-wrench"></i> Bakıma Gönder
                        </a>
                    }
                    @if (Model.Status == StatusEnum.KullanimDisi.ToString())
                    {
                        <a href="@Url.Action("SendToStock", "Asset", new { id = Model.Id })"
                           class="btn btn-success "
                           data-bs-toggle="tooltip"
                           title="Stoğa Geri Çek">
                            <i class="fa fa-box"></i> Stoğa Geri Çek
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("SendToDeactivate", "Asset", new { id = Model.Id })"
                           class="btn btn-warning"
                           data-bs-toggle="tooltip"
                           title="Kullanım Dışı İşaretle">
                            <i class="fa fa-ban"></i> Kullanım Dışı İşaretle
                        </a>
                    }
                  
                    @if (!Model.IsDeleted)
                    {
                        
                        <a href="@Url.Action("DeActive", "Asset", new { id = Model.Id })" class="btn btn-info">
                            <i class="fa fa-times"></i> Pasif Et
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Active", "Asset", new { id = Model.Id })" class="btn btn-info">
                            <i class="fa fa-check"></i> Aktif Et
                        </a>
                    }
                    <a href="@Url.Action("Remove", "Asset", new { id = Model.Id })" class="btn btn-danger">
                        <i class="fa fa-trash-alt"></i> Sil
                    </a>
                </div>

            </div>
        </div>

        <div class="card-footer text-muted small text-end">
            Oluşturulma: @Model.CreatedDate.ToShortDateString() |
            @(Model.IsDeleted ? "Silinmiş" : "Aktif")
        </div>
    </div>
</div>
