@model List<UserAssetViewModel>

@{
    ViewData["Title"] = "Kullanıcıya Ait Envanterler";
}

<div class="container mt-2">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-laptop me-2"></i> Envanter Listesi
            </h4>
          @*   <a href="#" class="btn btn-light btn-sm shadow-sm">
                <i class="bi bi-arrow-clockwise me-1"></i> Yenile
            </a> *@
        </div>

        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center py-4">
                    <i class="bi bi-info-circle me-2"></i> Henüz herhangi bir envanter bulunmuyor.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-primary">
                            <tr>
                                <th>#</th>
                                <th>Asset Tag</th>
                                <th>Seri No</th>
                                <th>Tür</th>
                                <th>Model</th>
                                <th>Marka</th>
                                <th>Satıcı</th>
                                <th>Lokasyon</th>
                                <th>Durum</th>
                                <th>Kiralık mı?</th>
                                <th>Oluşturulma</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in Model)
                            {
                                <tr>
                                    <td>@asset.Id</td>
                                    <td><span class="fw-semibold">@asset.AssetTag</span></td>
                                    <td>@asset.SerialNumber</td>
                                    <td>@asset.TypeName</td>
                                    <td>@asset.ModelName</td>
                                    <td>@asset.BrandName</td>
                                    <td>@asset.VendorName</td>
                                    <td>@asset.LocationName</td>
                                    <td>
                                        <span class="badge
                                                    @(asset.Status == "Active" ? "bg-success" :
                                                                                            asset.Status == "Maintenance" ? "bg-warning text-dark" :
                                                                                            "bg-secondary")">
                                    @asset.Status
                                </span>
                            </td>
                            <td>
                                @if (asset.IsRented)
                                        {
                                            <span class="badge bg-info text-dark">Evet</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">Hayır</span>
                                        }
                                    </td>
                                    <td>@asset.CreatedDate.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
