@using EnvanteriX.WebUI.ViewModels.User
@model PaginatedUserViewModel

@{
    var viewModel = Model ?? new PaginatedUserViewModel();

    var currentFilters = new Dictionary<string, string>();
    if (Context.Request.Query.ContainsKey("searchTerm"))
        currentFilters["searchTerm"] = Context.Request.Query["searchTerm"].ToString();
    if (Context.Request.Query.ContainsKey("role"))
        currentFilters["role"] = Context.Request.Query["role"].ToString();
    if (Context.Request.Query.ContainsKey("isDeleted"))
        currentFilters["isDeleted"] = Context.Request.Query["isDeleted"].ToString();
}

<div class="col-md-12">
    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="card-title mb-0">Kullanıcı Listesi</h4>
                <button class="btn btn-primary btn-round" onclick="navigateWithLoading('/User/Add');">
                    <i class="fa fa-plus"></i>
                    Yeni Kullanıcı
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Filtreleme Bölümü -->
            <div class="filter-section mb-4">
                <form id="filterForm" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Arama</label>
                        <input type="text"
                               class="form-control"
                               id="searchTerm"
                               name="searchTerm"
                               placeholder="Ad, kullanıcı adı veya email ara..."
                               value="@(currentFilters.ContainsKey("searchTerm") ? currentFilters["searchTerm"] : "")">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Rol</label>
                        <select class="form-select" id="role" name="role">
                            <option value="">Tümü</option>
                            @{
                                var isAdminSelected = currentFilters.ContainsKey("role") && currentFilters["role"] == "admin";
                                var isUserSelected = currentFilters.ContainsKey("role") && currentFilters["role"] == "user";
                            }
                            <option value="admin" selected="@isAdminSelected">Admin</option>
                            <option value="user" selected="@isUserSelected">User</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Durum</label>
                        <select class="form-select" id="isDeleted" name="isDeleted">
                            <option value="">Tümü</option>
                            @{
                                var isDeletedFalse = currentFilters.ContainsKey("isDeleted") && currentFilters["isDeleted"] == "false";
                                var isDeletedTrue = currentFilters.ContainsKey("isDeleted") && currentFilters["isDeleted"] == "true";
                            }
                            <option value="false" selected="@isDeletedFalse">Aktif</option>
                            <option value="true" selected="@isDeletedTrue">Pasif</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-filter"></i> Filtrele
                            </button>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-secondary" onclick="clearFilters()">
                                <i class="fa fa-times"></i> Temizle
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Sayfa Boyutu ve Bilgi -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <label class="me-2">Sayfa Başına:</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm d-inline-block" style="width: auto;">
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    </select>
                </div>
                <div>
                    <strong>Toplam @Model.TotalCount kayıt</strong> (Sayfa @Model.PageNumber / @Model.TotalPages)
                </div>
            </div>

            <!-- Tablo -->
            <div class="table-responsive">
                <table class="table table-striped table-hover text-center">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Ad Soyad</th>
                            <th>Kullanıcı Adı</th>
                            <th>Mail</th>
                            <th>Rol</th>
                            <th>Oluşturma Tarihi</th>
                            <th>Aktif Mi</th>
                            <th style="width: 15%">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.FullName</td>
                                    <td>@item.UserName</td>
                                    <td>@item.Email</td>
                                    <td>@item.Role</td>
                                    <td>@item.CreatedDate</td>
                                    <td>
                                        @if (!item.IsDeleted)
                                        {
                                            <i class="fa fa-check text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fa fa-times text-danger"></i>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 justify-content-center">
                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    data-bs-toggle="tooltip"
                                                    title="Profil"
                                                    onclick="navigateWithLoading('@Url.Content("~/User/Profile/" + item.Id)');">
                                                <i class="ti ti-user"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    data-bs-toggle="tooltip"
                                                    title="Edit"
                                                    onclick="navigateWithLoading('@Url.Content("~/User/Edit/" + item.Id)');">
                                                <i class="fa fa-edit"></i>
                                            </button>

                                            @if (!item.IsDeleted)
                                            {
                                                <button type="button"
                                                        class="btn btn-danger btn-sm confirm-btn"
                                                        data-bs-toggle="tooltip"
                                                        title="DeActive"
                                                        data-url="@Url.Content("~/User/DeActive/" + item.Id)">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-success btn-sm confirm-btn"
                                                        data-bs-toggle="tooltip"
                                                        title="Active"
                                                        data-url="@Url.Content("~/User/Active/" + item.Id)">
                                                    <i class="fa fa-check"></i>
                                                </button>
                                            }

                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm confirm-btn"
                                                    data-bs-toggle="tooltip"
                                                    title="Remove"
                                                    data-url="@Url.Content("~/User/Remove/" + item.Id)">
                                                <i class="fa fa-trash-alt"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-warning btn-sm"
                                                    data-bs-toggle="tooltip"
                                                    title="Şifreyi Değiştir"
                                                    onclick="navigateWithLoading('@Url.Content("~/User/ChangePassword/" + item.Id)');">
                                                <i class="fa fa-key"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <i class="fa fa-inbox fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">Kayıt bulunamadı</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sayfalama Kontrolleri -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Sayfa navigasyonu">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="changePage(@(Model.PageNumber - 1)); return false;">
                                <i class="fa fa-chevron-left"></i> Önceki
                            </a>
                        </li>

                        @{
                            int startPage = Math.Max(1, Model.PageNumber - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);

                            if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="#" onclick="changePage(1); return false;">1</a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="#" onclick="changePage(@i); return false;">@i</a>
                                </li>
                            }

                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="#" onclick="changePage(@Model.TotalPages); return false;">@Model.TotalPages</a>
                                </li>
                            }
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="changePage(@(Model.PageNumber + 1)); return false;">
                                Sonraki <i class="fa fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<script>
    document.getElementById('filterForm').addEventListener('submit', function(e) {
        e.preventDefault();
        applyFilters();
    });

    document.getElementById('pageSizeSelect').addEventListener('change', function() {
        applyFilters(1);
    });

    function applyFilters(pageNumber) {
        var params = new URLSearchParams();
        params.append('pageNumber', pageNumber || 1);
        params.append('pageSize', document.getElementById('pageSizeSelect').value);

        var searchTerm = document.getElementById('searchTerm').value;
        if (searchTerm) params.append('searchTerm', searchTerm);

        var role = document.getElementById('role').value;
        if (role) params.append('role', role);

        var isDeleted = document.getElementById('isDeleted').value;
        if (isDeleted) params.append('isDeleted', isDeleted);

        window.location.href = '/User?' + params.toString();
    }

    function changePage(pageNumber) {
        applyFilters(pageNumber);
    }

    function clearFilters() {
        window.location.href = '/User';
    }
</script>
