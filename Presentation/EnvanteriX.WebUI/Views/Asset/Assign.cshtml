@model UpdateAssetAssignViewModel
@{
    ViewData["Title"] = "Assign";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">
            <div class="card-body">
                <h1 class="mb-4 card-title">Rol Bilgilerini Güncelleyebilirsiniz.</h1>
                @using (Html.BeginForm("Assign", "Asset", FormMethod.Post, new { @action = "/Asset/Assign" }))
                {
                    <div class="row mb-3">
                        <label for="Id" class="col-sm-2 col-form-label">Varlık Id</label>
                        <div class="col-sm-10">
                            <input type="hidden" asp-for="Id" />
                            <label class="form-control" id="Id" asp-for="Id">@Model.Id </label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="AssignedUserId" class="col-sm-2 col-form-label">Atanan Kullanıcı</label>
                        <div class="col-sm-10">
                            @Html.DropDownListFor(model => model.AssignedUserId, ViewBag.Users as SelectList, "-- Atanacak Kullanıcıyı Seçiniz --", new { @class = "select2 form-control", style = "width: 100%", id = "userSelect" })
                        </div>
                    </div>


                    <div class="row mb-3 mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-lg btn-primary me-2">Kaydet</button>
                            <button type="button" class="btn btn-lg btn-secondary" onclick="goBack()">Geri Dön</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


