@model CreateUserViewModel
@{
    ViewData["Title"] = "Add";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">
            <div class="card-body">
                <h1 class="mb-4 card-title">Yeni Kullanıcı Bilgilerini Giriniz.</h1>
                @using (Html.BeginForm("Add", "User", FormMethod.Post))
                {
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Adı ve Soyadı</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(Model => Model.FullName, new { @class = "form-control", type = "text", placeholder = "Ad ve Soyadı Girin" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Email" class="col-sm-2 col-form-label">Mail</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.Email, new {
                            @class = "form-control",
                                                type = "email",
                                                placeholder = "Mail adresinizi girin"
                                                })
                    </div>
                </div>
                <div class="row mb-3">
                    <label for="Password" class="col-sm-2 col-form-label">Şifre</label>
                    <div class="col-sm-10">
                        @Html.PasswordFor(model => model.Password, new {
                                                @class = "form-control",
                                                type = "password",
                                                placeholder = "Şifrenizi girin"
                                                })
                    </div>
                </div>
                <div class="row mb-3">
                    <label for="ConfirmPassword" class="col-sm-2 col-form-label">Şifre Doğrulama</label>
                    <div class="col-sm-10">
                        @Html.PasswordFor(model => model.ConfirmPassword, new {
                                                @class = "form-control",
                                                type = "Password",
                                                placeholder = "Şifrenizi tekrar girin"
                                                })
                    </div>
                </div>
                <div class="row mb-3">
                    <label for="UserName" class="col-sm-2 col-form-label">Rol Seçin</label>
                    <div class="col-sm-10">
                        @Html.DropDownList("RoleId", ViewBag.Roles as SelectList, new { @class = " select2 form-control", id = "roleSelect" })
                    </div>
                </div>
                <div class="row mb-3 mt-4">
                    <div class="col-12 text-center">
                        <button type="submit" class="btn btn-lg btn-primary me-2">Kaydet</button>
                        <button type="button" class="btn btn-lg btn-secondary" onclick="goBack()">Geri Dön</button>
                    </div>
                </div>
                                }
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        $('#roleSelect').select2({
             theme: 'bootstrap-5',
            placeholder: "Rol seçiniz",
            allowClear: true
        });
    });
</script>
