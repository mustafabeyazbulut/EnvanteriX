@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #1e1e2f, #2d2d44);
            color: #fff;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .card {
            text-align: center;
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px 60px;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.4);
        }

        .icon {
            font-size: 80px;
            color: #ff6b6b;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        p {
            font-size: 18px;
            color: #ccc;
            margin-bottom: 30px;
        }

        .btn {
            background: #ff6b6b;
            color: white;
            text-decoration: none;
            padding: 12px 30px;
            border-radius: 8px;
            transition: 0.3s;
            font-weight: 500;
        }

            .btn:hover {
                background: #ff8787;
            }

        footer {
            position: absolute;
            bottom: 20px;
            font-size: 14px;
            color: #888;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">🚫</div>
        <h1>Erişim Engellendi</h1>
        <p>Bu sayfaya erişim yetkiniz bulunmamaktadır.</p>
        <a href="/" class="btn">Ana Sayfaya Dön</a>
    </div>

    <footer>© @DateTime.Now.Year - Sistem Erişim Kontrolü</footer>
</body>
</html>
